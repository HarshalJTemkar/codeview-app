<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Current Spring Boot line (released 2026-06-10). Requires Java 21 minimum,
             already satisfied. Built on Spring Framework 7 / Jakarta EE 11. -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.codeview</groupId>
    <artifactId>codeview-app</artifactId>
    <version>1.0.0</version>
    <name>codeview-app</name>
    <description>
        Read-only, zero-token, no-auth code intelligence server: AST chunking,
        Merkle-hashed incremental indexing, Open Knowledge Format (OKF) knowledge
        store, and an MCP-shaped REST API including the prompt-time context filter.
    </description>

    <properties>
        <java.version>21</java.version>
        <javaparser.version>3.28.2</javaparser.version>
        <snakeyaml.version>2.2</snakeyaml.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- AST parsing for Java source. Used instead of Tree-sitter: Tree-sitter has
             no ready-made Maven Central dependency for Java grammars, so this is a
             flagged deviation from the source design doc, not a silent substitution. -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>

        <!-- YAML frontmatter read/write for OKF concept files -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>codeview-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
